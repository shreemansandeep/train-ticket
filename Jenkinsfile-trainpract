pipeline {
    agent any

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/shreemansandeep/train-ticket.git'
            }
        }

        stage('Unit Testing') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Maven Build') {
            steps {
                sh 'mvn clean package'
            }
        }
        
        stage('SonarQube Analysis') {
    steps {
        script {

            // Fetch Sonar Token from AWS Secrets Manager
            def sonarToken = sh(
                script: """
                    aws secretsmanager get-secret-value \
                    --secret-id test/train/sonarid \
                    --region ap-south-1 \
                    --query SecretString \
                    --output text | jq -r '.SONAR_TOKEN'
                """,
                returnStdout: true
            ).trim()

            sh """
                sonar-scanner \
                mvn clean verify sonar:sonar \
                  -Dsonar.projectKey=training-app \
                  -Dsonar.host.url=http://<SONAR_SERVER_IP>:9000 \
                  -Dsonar.token=${sonarToken}
            """
        }
    }
}
    }
}

